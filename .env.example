# ── Supabase ──────────────────────────────────────────────────────────────
# 1. Create a project at https://supabase.com/dashboard
# 2. Project Settings → API → copy these two values
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR-PUBLISHABLE-KEY

# 3. Project Settings → API → Service role (secret). NEVER expose to client code.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# ── Demo mode (optional, dev only) ───────────────────────────────────────
# Runs the whole staff portal on an in-memory mock backend seeded with sample
# data. No Supabase account required. Login creds:
#   demo@marketadigitalit.in / Demo@1234  (super admin)
#   every staff member: FirstName@1234   (e.g. Ananya@1234, Rahul@1234)
#   employees created via the portal default to Staff@1234
# The login page lists all demo accounts. Never set this to true in production.
NEXT_PUBLIC_DEMO_AUTH=false

# ── Site URL (used for password reset redirects & robots) ───────────────
# Leave empty in local dev; set to your production domain on Vercel.
NEXT_PUBLIC_SITE_URL=https://marketadigitalit.com

# ── Lead email alerts (optional) ─────────────────────────────────────────
# When set, every website enquiry POSTs to this webhook so your team gets email.
# Point it at a service that turns the payload into mail (Resend, Brevo,
# Zapier/Make/n8n, Slack...). No-op until configured.
LEAD_ALERT_WEBHOOK_URL=https://your-webhook.example.com/send

# Optional Bearer token the webhook expects
LEAD_ALERT_WEBHOOK_KEY=

# Comma-separated recipients, forwarded in the payload for the webhook to use
LEAD_ALERT_EMAILS=sales@marketadigitalit.com

# ── Leave notifications to employees (optional) ──────────────────────────
# On leave approve/reject, the employee gets an email + WhatsApp message.
# Each is a webhook that turns the payload below into a real message.
# No-op until configured; failures never block the review action.
#   LEAVE_EMAIL_WEBHOOK_URL  → email the employee (Resend/Brevo/SMTP wrapper...)
#   WHATSAPP_WEBHOOK_URL     → WhatsApp the employee (Twilio/Gupshup/360dialog...)
LEAVE_EMAIL_WEBHOOK_URL=https://your-webhook.example.com/leave-email
LEAVE_EMAIL_WEBHOOK_KEY=
WHATSAPP_WEBHOOK_URL=https://your-webhook.example.com/whatsapp
WHATSAPP_WEBHOOK_KEY=
# Optional sender number forwarded in the WhatsApp payload
WHATSAPP_FROM_NUMBER=+91XXXXXXXXXX