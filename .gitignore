# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit real credentials, but DO keep the template
# so new devs know which variables are required.
.env*
!.env.example

# vercel
.vercel

# supabase cli caches (schema.sql under supabase/ IS committed)
supabase/.temp
supabase/.branches
supabase/.env

# turbopack / swc caches
.turbo
.swc

# logs
*.log
logs/

# editors & OS cruft
Thumbs.db
Desktop.ini
*.swp
*.swo
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# typescript
*.tsbuildinfo
next-env.d.ts
